{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "targetSecret": {
      "type": "string"
    },
    "activeDeadlineSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "backoffLimit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "ttlSecondsAfterFinished": {
      "type": "integer",
      "minimum": 0
    },
    "vault": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "credentialsSecret": {
          "type": "string"
        },
        "caSecret": {
          "type": "string"
        },
        "allowInsecureHTTP": {
          "type": "boolean"
        },
        "approleMount": {
          "type": "string",
          "minLength": 1
        },
        "kvMount": {
          "type": "string",
          "minLength": 1
        },
        "secretPath": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "targetSecret": {
            "minLength": 1
          },
          "vault": {
            "properties": {
              "address": {
                "minLength": 1
              },
              "credentialsSecret": {
                "minLength": 1
              },
              "secretPath": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
